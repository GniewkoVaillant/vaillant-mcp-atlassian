{
  "name": "mcp-atlassian",
  "version": "1.1.0",
  "description": "MCP server connecting Copilot to on-prem Jira Data Center and Confluence Data Center via Personal Access Tokens, with read and write tools.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-atlassian": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/__tests__",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:dist": "tsc -p tsconfig.build.json",
    "prepare": "npm run build:dist",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:unit": "npm run build && node --test dist/__tests__/*.test.js",
    "test:smoke": "npm run build && node scripts/smoke-test.mjs",
    "test": "npm run lint && npm run test:unit && npm run test:smoke"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "jira",
    "confluence",
    "atlassian",
    "copilot"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "htmlparser2": "^12.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "eslint": "^9.39.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0"
  }
}
