# Jira Data Center
JIRA_BASE_URL=https://jira.example.com
JIRA_PAT=your-jira-personal-access-token

# Confluence Data Center
CONFLUENCE_BASE_URL=https://confluence.example.com
CONFLUENCE_PAT=your-confluence-personal-access-token

# --- Optional hardening ---

# Where the server reads this file from. Unset, it looks for a .env next to the
# install root (one level above dist/). Set it to an absolute path to keep the
# file elsewhere; a path that cannot be read is a startup error, not a fallback.
# Real environment variables always win over whatever the file contains.
# ATLASSIAN_ENV_FILE=/etc/mcp-atlassian/.env

# Refuse every mutating tool (create/update/delete/transition/comment/worklog).
# Recommended when the agent reads untrusted content (e.g. third-party Jira comments).
# This also covers local-filesystem tools, not only writes to Jira/Confluence:
# jira_download_attachment and confluence_download_attachment are withheld as
# well, because they write to the local disk.
ATLASSIAN_READ_ONLY=false

# Destructive tools are never registered unless explicitly enabled. This gate
# covers deletions plus the two property writes (jira_set_issue_property,
# confluence_set_content_property), which overwrite state belonging to installed
# apps such as ProForma with no version history and no undo.
# Keep false for normal development and production workloads.
ATLASSIAN_ALLOW_DESTRUCTIVE=false

# Which tool groups to expose. This is the single most effective knob you have:
# the full surface is 133 tools and roughly 30k tokens of definitions on EVERY
# model request. Pick the smallest set that covers your work.
#
# Groups:
#   core        - search/get issues and fields, Confluence read, page tree, labels,
#                 restrictions (read-only), trash listing
#   forms       - ProForma forms
#   meta        - create/edit metadata, field catalogue, dictionaries, project
#                 configuration, JQL autocomplete, version and component CRUD
#   users       - user and group lookup, effective permissions (read-only)
#   filters     - saved filters, share permissions, dashboards
#   write       - create/update/comment/transition/worklog, Confluence page and
#                 space writes, labels, watches, trash restore
#   files       - attachments, including Confluence uploads
#   links       - issue links and remote (external URL) links
#   agile       - boards, sprints, velocity, backlog, ranking
#   dev         - dev-status, changelog, cycle time
#   servicedesk - Jira Service Management requests, queues, SLAs, approvals
#
# Named profiles:
#   full    - every group (default) ~133 tools
#   classic - the surface before the metadata/directory/filter/JSM expansion (86)
#   ppm     - core, forms, write, files, links, meta, users (94)
#   agile   - core, agile, dev, meta, users (66)
#   service - core, servicedesk, users (42)
#   read    - every group, read-only tools only; also forces read-only mode (85)
#   core    - issue and page lookup only (24)
#
# A raw comma-separated group list also works, e.g. ATLASSIAN_PROFILE=core,agile.
ATLASSIAN_PROFILE=full

# Directories that attachment download/upload are allowed to touch.
# The separator is platform-dependent (Node's path.delimiter): a colon (:) on
# Linux/macOS, a semicolon (;) on Windows. Empty disables all filesystem access.
ATLASSIAN_ATTACHMENT_DIRS=

# Per-request HTTP timeout in milliseconds (default 30000).
ATLASSIAN_TIMEOUT_MS=30000

# Total wall-clock budget across queueing, retries and retry backoff.
ATLASSIAN_TOTAL_TIMEOUT_MS=45000

# Process-wide upstream pressure controls; excess requests fail closed.
ATLASSIAN_MAX_CONCURRENT_REQUESTS=4
ATLASSIAN_MAX_QUEUED_REQUESTS=16

# Maximum attachment size in bytes (default 10 MiB).
ATLASSIAN_MAX_ATTACHMENT_BYTES=10485760

# Maximum upstream pages automatically traversed by one auto-paginating
# operation. This covers the Jira Agile paths (boards, sprints, sprint issues),
# the Jira changelog walk (jira_get_issue_changelog, jira_get_issue_cycle_time)
# and the Confluence ones (confluence_list_spaces, confluence_get_page_children,
# confluence_list_comments). Exceeding the budget is an error; partial results
# are never returned as if they were complete.
ATLASSIAN_MAX_PAGINATION_PAGES=10

# Largest JSON response body accepted from Jira/Confluence (default 16 MiB).
# A larger body is refused before it is buffered, instead of being assembled in
# memory. Raise only if a legitimate query genuinely returns more than this.
ATLASSIAN_MAX_JSON_BYTES=16777216

# Largest text result handed back to the model by a single tool call
# (default 150000 bytes). Anything above is cut and an explicit truncation
# marker naming the dropped byte count is appended, so a fragment can never be
# mistaken for a complete answer.
ATLASSIAN_MAX_TOOL_RESULT_BYTES=150000

# --- Optional smoke-test settings (npm run test:smoke) ---
# Not read by the server itself; only scripts/smoke-test.mjs consults these.

# Enables authenticated, read-only upstream smoke checks. Off by default so a
# routine build never queries production merely because credentials exist.
# ATLASSIAN_SMOKE_LIVE=true

# A read-only Jira issue containing at least one ProForma form, used only when
# ATLASSIAN_SMOKE_LIVE=true. When set, the smoke test also exercises
# jira_get_issue_fields (without fieldNames) and jira_get_proforma_forms_summary
# against this issue. Do not point this at an issue you cannot afford to have
# read; the smoke test never writes to it.
# ATLASSIAN_SMOKE_JIRA_ISSUE=PPM-00000
