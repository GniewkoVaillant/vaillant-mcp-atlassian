# Jira Data Center
JIRA_BASE_URL=https://jira.example.com
JIRA_PAT=your-jira-personal-access-token

# Confluence Data Center
CONFLUENCE_BASE_URL=https://confluence.example.com
CONFLUENCE_PAT=your-confluence-personal-access-token

# --- Optional hardening ---

# Refuse every mutating tool (create/update/delete/transition/comment/worklog).
# Recommended when the agent reads untrusted content (e.g. third-party Jira comments).
# This also covers local-filesystem tools, not only writes to Jira/Confluence:
# jira_download_attachment and confluence_download_attachment are withheld as
# well, because they write to the local disk.
ATLASSIAN_READ_ONLY=false

# Destructive tools are never registered unless explicitly enabled.
# Keep false for normal development and production workloads.
ATLASSIAN_ALLOW_DESTRUCTIVE=false

# Which tool groups to expose. Reduces the tools/list payload sent to the model.
#   core   - search/get issues, fields, Confluence read
#   forms  - ProForma forms
#   write  - create/update/comment/transition/worklog
#   files  - attachments
#   links  - issue links
#   agile  - boards, sprints, velocity, story points
#   dev    - dev-status, changelog, cycle time
#   full   - everything (default)
ATLASSIAN_PROFILE=full

# Directories that attachment download/upload are allowed to touch.
# The separator is platform-dependent (Node's path.delimiter): a colon (:) on
# Linux/macOS, a semicolon (;) on Windows. Empty disables all filesystem access.
ATLASSIAN_ATTACHMENT_DIRS=

# Per-request HTTP timeout in milliseconds (default 30000).
ATLASSIAN_TIMEOUT_MS=30000

# Total wall-clock budget across queueing, retries and retry backoff.
ATLASSIAN_TOTAL_TIMEOUT_MS=45000

# Process-wide upstream pressure controls; excess requests fail closed.
ATLASSIAN_MAX_CONCURRENT_REQUESTS=4
ATLASSIAN_MAX_QUEUED_REQUESTS=16

# Maximum attachment size in bytes (default 10 MiB).
ATLASSIAN_MAX_ATTACHMENT_BYTES=10485760

# Maximum upstream pages automatically traversed by one Jira Agile operation.
ATLASSIAN_MAX_PAGINATION_PAGES=10
